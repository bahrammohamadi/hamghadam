# Names only. Real values live in the Vercel project settings (and Supabase dashboard),
# never in git. The Android app never receives any of these.

# Supabase project (public values, safe to classify as client-visible)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS; used for the audit trail. Never ship to the app.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider (any OpenAI-compatible endpoint)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=

# Optional comma-separated browser origins allowed to call /api/agent.
# Empty = browsers are rejected; the native app sends no Origin header.
ALLOWED_ORIGINS=
