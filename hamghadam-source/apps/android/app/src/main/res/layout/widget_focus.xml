<?xml version="1.0" encoding="utf-8"?>
<!-- «تمرکز» 2×2: today's focus minutes, goal, one-tap 25-minute session. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_focus_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تمرکز امروز"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_focus_minutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFFFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_focus_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D9FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_focus_start"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_focus_button"
        android:gravity="center"
        android:text="شروع ۲۵ دقیقه"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
